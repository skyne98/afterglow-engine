{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "WebWorker"],
    "types": []
  },
  "include": ["web/src/*.ts", "contracts/diagnostics.type-test.ts"],
  "exclude": ["web/src/*.test.ts"]
}
