{
  "version": 2,
  "description": "Game-engine acceptance classes. Classification changes require a documented root cause, never an example workaround.",
  "classes": {
    "core-gpu-differential": {
      "pixelThresholdPercent": 0.1,
      "requirements": [
        "no runtime error",
        "deterministic repeat hash",
        "equivalent resource state and command ordering",
        "documented numeric tolerance only after state equivalence"
      ],
      "examples": [
        "webgpu_compute_rasterizer",
        "webgpu_lights_custom",
        "webgpu_lights_pointlights",
        "webgpu_lights_rectarealight",
        "webgpu_lines_fat_raycasting",
        "webgpu_materials_arrays",
        "webgpu_materials_envmaps_bpcem",
        "webgpu_multisampled_renderbuffers",
        "webgpu_refraction",
        "webgpu_textures_anisotropy",
        "webgpu_volume_lighting_rectarea"
      ],
      "sameAdapterDiagnostics": "e2e/gpu_fidelity_diagnosis.json"
    },
    "runtime-visual-golden": {
      "requirements": [
        "no runtime error",
        "byte-identical repeat hash against the runtime-native golden",
        "structurally correct layout and readable text",
        "defined temporal warm-up frame count"
      ],
      "examples": [
        "webgpu_camera",
        "webgpu_camera_logarithmicdepthbuffer",
        "webgpu_centroid_sampling",
        "webgpu_compile_async",
        "webgpu_compute_birds",
        "webgpu_compute_particles",
        "webgpu_compute_reduce",
        "webgpu_compute_texture_pingpong",
        "webgpu_compute_water",
        "webgpu_hdr",
        "webgpu_instancing_morph",
        "webgpu_layers",
        "webgpu_loader_texture_ktx2",
        "webgpu_materials_alphahash",
        "webgpu_materials_texture_manualmipmap",
        "webgpu_multiple_canvas",
        "webgpu_postprocessing",
        "webgpu_postprocessing_afterimage",
        "webgpu_postprocessing_pixel",
        "webgpu_postprocessing_retro",
        "webgpu_postprocessing_smaa",
        "webgpu_postprocessing_ssr",
        "webgpu_reflection_blurred",
        "webgpu_reversed_depth_buffer",
        "webgpu_shadertoy",
        "webgpu_tsl_compute_attractors_particles",
        "webgpu_tsl_vfx_tornado",
        "webgpu_upscaling_fsr1",
        "webgpu_upscaling_taau"
      ],
      "warmupMilliseconds": 1000,
      "goldenDirectory": "e2e/runtime_goldens/nvidia-rtx3090",
      "adapter": {
        "vendor": "NVIDIA",
        "device": "GeForce RTX 3090",
        "backend": "Vulkan"
      }
    },
    "optional-browser-feature": {
      "requirements": [
        "explicitly excluded unless the product enables the video subsystem",
        "must fail as an unsupported capability rather than silently no-op"
      ],
      "examples": [
        "webgpu_video_frame",
        "webgpu_video_panorama"
      ]
    }
  }
}
