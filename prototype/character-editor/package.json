{
  "name": "character-editor-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "gen:character": "bun scripts/gen-makehuman.ts",
    "validate:character": "bun scripts/validate-character-glb.ts",
    "test:cc": "cc -O2 -std=c11 -Ipaint -Ipaint/vendor/libmypaint -Ipaint/vendor/json-c/build paint/layer-compositor.c paint/layer-compositor.parity.test.c paint/vendor/libmypaint/helpers.c paint/vendor/libmypaint/rng-double.c -lm -o /tmp/lc-parity && /tmp/lc-parity",
    "test:paint": "cargo test --manifest-path paint/maipointo/Cargo.toml --features demo",
    "test": "bun test src/*.test.ts && bun run validate:character && bun run test:cc && bun run test:paint && bunx vue-tsc --noEmit"
  },
  "dependencies": {
    "@lucide/vue": "^1.40.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "three": "0.185.1",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/three": "0.183.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "shadcn-vue": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^6.0.0",
    "vue-tsc": "^3.3.11"
  }
}
