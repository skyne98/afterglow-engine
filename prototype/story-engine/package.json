{
  "name": "story-engine-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:server": "bun --watch server/src/index.ts",
    "dev:web": "vite",
    "dev": "concurrently -n server,web -c blue,green \"bun run dev:server\" \"bun run dev:web\"",
    "migrate": "bun server/src/migrate.ts",
    "test": "bun test server/src/*.test.ts web/src/sandbox/*.test.ts && bun run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "pixi.js": "^8.19.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "concurrently": "^9.1.0",
    "typescript": "5.9.3",
    "vite": "^6.0.0"
  }
}
